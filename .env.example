# ===== 本地开发 =====
# 后端 (server/, 复制为 server/.env)
PORT=3000
DATABASE_URL=postgresql://musicroom:musicroom_dev@localhost:5432/musicroom
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-change-me

# 网易云 API 代理(见 docker-compose.yml)
NETEASE_API_URL=http://localhost:3001

# MinIO(自建曲库,见 docker-compose.yml)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev
MINIO_BUCKET=musicroom

# ===== 生产部署(服务器根目录 .env,docker-compose.prod.yml 读取) =====
# 必改: JWT_SECRET / POSTGRES_PASSWORD / MINIO_SECRET_KEY 换成强随机值!
# POSTGRES_PASSWORD=<强密码>
# POSTGRES_USER=musicroom
# POSTGRES_DB=musicroom
# DATABASE_URL=postgresql://musicroom:<强密码>@postgres:5432/musicroom
# REDIS_URL=redis://redis:6379
# JWT_SECRET=<随机 32+ 字节>
# NETEASE_API_URL=http://netease-api:3000
# MINIO_ENDPOINT=minio
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=<强密码>
# MINIO_BUCKET=musicroom
